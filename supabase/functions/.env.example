# Use a random 32-byte key encoded as 64 hexadecimal characters.
# Keep this value stable after Zernio credentials have been encrypted.
ZERNIO_ENCRYPTION_KEY=<64_HEX_CHARACTERS>

# Public HTTPS URL where the SGA frontend is hosted.
ZERNIO_REDIRECT_BASE_URL=https://<DOMINIO_PUBLICO_DO_SGA>

# Supabase webhook receiver used by Mercado Pago.
MP_WEBHOOK_URL=https://<PROJECT_REF>.supabase.co/functions/v1/payment-webhook-receiver

# Official WhatsApp Cloud API (Meta). META_APP_ID is public and is returned to
# the browser by the meta-integration function; META_APP_SECRET never leaves
# the Edge Function.
META_APP_ID=<META_APP_ID>
META_APP_SECRET=<META_APP_SECRET>

# WhatsApp Embedded Signup configuration id, taken from the Meta App
# (WhatsApp > API Setup > Embedded Signup).
META_CONFIGURATION_ID=<CONFIGURATION_ID>

# Graph API version used for every Meta call.
META_GRAPH_VERSION=v23.0

# Optional dedicated key for the Meta access tokens. When empty, the SGA falls
# back to ZERNIO_ENCRYPTION_KEY, so existing credentials keep working.
META_ENCRYPTION_KEY=<64_HEX_CHARACTERS>
